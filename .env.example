APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=


REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

WEBHOOK_SECRET=thisismytoken

# Shared secret for internal node->API requests (Vector bandwidth ingest, etc).
# On edge nodes, INTERNAL_API_URL is derived from APP_URL automatically (see NodeService).
INTERNAL_API_SECRET=changeme-internal-secret

# Both auto-size from the node's cores and RAM (cgroup limits included); set only to override.
# VIDEO_WORKER_PROCESSES=
# VIDEO_FFMPEG_THREADS=
VIDEO_WORKER_TIMEOUT=600
# Videos encoding at once, fleet-wide. NOT the node count: one video already fans out across every
# worker, so this only bounds how deep the shared queue gets — and therefore how long a short video
# can end up waiting behind a long one. Raise only if short videos leave the fleet idle.
# VIDEO_CONCURRENT=2
# Set true on a worker node that should NOT run the packaging supervisor (opt-out).
# DISABLE_PACKAGING=false

# With APP_ENV=local a node deploy builds its image from the working copy (`:node-dev`) and names
# its containers `nukevideo_dev_*`, so a development node can share a host with production ones.
# The chunk store it deploys takes its port from the node's storage endpoint.
#
# Where node images live. Leave it unset in production: images then resolve to the Docker Hub
# namespace the releases are published under. Set it to your own registry (host:port, no scheme) to
# pull from there — and, in development, to push each build so an external test node can run it.
# Over plain HTTP every machine involved needs it in /etc/docker/daemon.json "insecure-registries".
# DOCKER_REGISTRY=10.0.0.240:5000

SENTRY_LARAVEL_DSN=null
SENTRY_TRACES_SAMPLE_RATE=1.0

# API host: videos each active worker node may have in flight (videos:dispatch).
# Keep it equal to the nodes' ORCHESTRATION_WORKER_PROCESSES.
VIDEOS_PER_NODE=5

# Worker nodes: Horizon processes on the orchestration queue (preparation, thumbnail,
# audio/subtitles). Each one prepares one video at a time.
ORCHESTRATION_WORKER_PROCESSES=5