{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose exec nukevideo-api php artisan config:clear)",
      "Bash(docker compose exec nukevideo-api php artisan test *)",
      "Bash(docker compose exec nukevideo-api ./vendor/bin/pint *)",
      "Bash(docker compose exec nukevideo-front pnpm run lint)",
      "Bash(docker compose exec nukevideo-front pnpm run type-check)"
    ],
    "deny": [
      "Bash(php artisan migrate:fresh *)",
      "Bash(php artisan migrate:reset *)",
      "Bash(php artisan db:wipe *)",
      "Bash(docker compose exec nukevideo-api php artisan migrate:fresh *)",
      "Bash(docker compose exec nukevideo-api php artisan migrate:reset *)",
      "Bash(docker compose exec nukevideo-api php artisan db:wipe *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./storage/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-php.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-front.sh"
          }
        ]
      }
    ]
  }
}
