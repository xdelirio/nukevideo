worker_processes  auto;

# The container starts with a soft limit of 1024 descriptors, under the 4096 connections a worker
# was told it may take — and a cache miss holds four or five at once (the viewer, both ends of the
# loopback hop, the S3 socket, the cache file), so a worker ran out at a couple of hundred
# concurrent misses. The master is root and may raise its workers to the hard limit.
worker_rlimit_nofile 65535;

# Disk reads off the cache pool run here instead of in the worker. A worker that blocks on a cold
# read of a 10 TB pool stalls every connection it holds, cache hits included; with the pool on
# spinning disks that was most reads past the page cache.
thread_pool default threads=32 max_queue=65536;

events {
    worker_connections  16384;
    multi_accept on;
}
http {

    server_tokens off;
    sendfile on;
    tcp_nopush on;
    aio threads;
    aio_write on;

    # The descriptors of hot segments, kept open across requests: a popular video's current
    # segments are read thousands of times a minute, each one an open() and a stat() otherwise.
    # Segments never change under a name, so a cached descriptor is never a stale one. Per
    # worker, and every entry holds a descriptor open: the ceiling stays well under
    # worker_rlimit_nofile, which the connections need too.
    open_file_cache max=16384 inactive=60s;
    open_file_cache_valid 60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors off;

    # Manifests and subtitle cues are text, and an MPD of a full AV1 ladder is tens of kB of
    # repetitive XML. Compressed after `secure_token` has rewritten it, so the tokens survive.
    # `proxied any` because every request here comes through Traefik, and the media types are
    # what the bucket answers with ({@see PackageVideoJob} sets them on upload).
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/dash+xml application/vnd.apple.mpegurl application/x-mpegurl text/vtt;

    # The loopback hop to the signing server below. Without a pool every request opened a fresh
    # TCP connection to it, and the server behind it one more to S3.
    upstream edge_origin {
        server 127.0.0.1:8080;
        keepalive 64;
    }

    # The bucket, held open between misses: without a pool every cache miss and every download
    # paid a TCP and a TLS handshake to S3 before its first byte. Re-resolved while running
    # (`resolve`, nginx 1.27.3+) when the entrypoint found a resolver, so an endpoint that moves
    # its addresses — most hosted S3 does — is followed instead of pinned to whatever it answered
    # at boot. The idle timeout stays under the ones S3 servers close on, so nginx drops a pooled
    # connection before the far end does.
    resolver ${EDGE_RESOLVER} valid=30s ipv6=off;
    upstream s3_origin {
        zone s3_origin 64k;
        server ${AWS_ENDPOINT_SERVER} ${AWS_ENDPOINT_RESOLVE};
        keepalive 32;
        keepalive_timeout 15s;
    }

    # ---- Master manifests are built by the API ----
    #
    # A master manifest (`{output}.mpd`, `{output}.m3u8`) is no longer the bucket's file as it
    # is: the API builds it for the link it was requested with — a resolution cap, subtitles as
    # plain WebVTT, whatever options the link's token names. Only the master: media playlists and
    # segments are the same bytes for every viewer and keep coming from the bucket.
    #
    # The API, held open like the bucket is. Unused, and pointed at a port nothing listens on,
    # when the entrypoint found no INTERNAL_API_URL.
    upstream manifest_api {
        zone manifest_api 64k;
        # The ceiling on what this edge may ask of the API at once, whoever is asking. The API
        # is a pool of PHP workers that also serves the panel and mints the links; past this the
        # request is not queued but answered from the bucket (see the `:8081` server).
        server ${MANIFEST_API_SERVER} ${MANIFEST_API_RESOLVE} max_conns=64;
        keepalive 16;
        keepalive_timeout 15s;
    }

    # The loopback hop that asks the API (the `:8081` server at the end of this file), pooled like
    # the hop to the signing server.
    upstream manifest_origin {
        server 127.0.0.1:8081;
        keepalive 16;
    }

    # `manifest_origin` for a master manifest when the API is configured, `edge_origin` otherwise
    # — which is every request on an edge deployed without INTERNAL_API_URL, unchanged.
    #
    # The file name is spelled out — an output ULID, an optional legacy cap, the extension — and
    # not "anything without a slash", for two reasons. It is the API route's own pattern, so
    # nothing matches here that the API would refuse. And the name is copied, decoded, into the
    # request line of the hop to the API: with `[^/]+` a name carrying an encoded CR LF wrote
    # header lines of the viewer's choosing into that request, next to the secret.
    map $uri $edge_upstream {
        "~^/[0-9A-Za-z]{26}/play/[0-9A-Za-z]+(\.[0-9]+)?\.(mpd|m3u8)$"  ${MANIFEST_UPSTREAM};
        default                                                         edge_origin;
    }

    # The key naming the options a link's manifests are built with, read out of its token like
    # `limit` below (App\Services\Cdn\ManifestOptionsRegistry). Empty for a link that asked for the
    # defaults. It passed the HMAC, so a viewer cannot pick another.
    map $link_token $link_mo {
        "~(^|~)mo=(?<m>[0-9a-f]{16})(~|$)"  $m;
        default                             "";
    }

    # What sets one built copy of a master manifest apart from another: the options key. It is
    # the whole difference — the API builds nothing viewer-specific into a manifest, and the token
    # is written in after the cache, on the way out — so viewers who asked for the same thing
    # share a cached copy and viewers who did not can never be handed each other's. Empty for
    # everything else, which keeps every segment under the key it has always had.
    map $edge_upstream $manifest_variant {
        manifest_origin  "|$link_mo";
        default          "";
    }

    # Who to count a master manifest's cache miss against (see `manifest_misses`).
    map $edge_upstream $manifest_client {
        manifest_origin  $remote_addr;
        default          "";
    }

    map $uri $video_ulid {
        "~^/(?<v>[0-9A-Za-z]{26})/"  $v;
        default                      -;
    }

    # The zone directory that follows the ULID — `play`, `download`, `assets`. It is what separates
    # streaming bytes from downloaded ones once the line reaches the metrics table; nothing downstream can
    # recover it from anywhere else.
    map $uri $video_zone {
        "~^/[0-9A-Za-z]{26}/(?<z>[a-z]+)/"  $z;
        default                             "";
    }

    # What the cache did with the request, for the log. Empty means the location had no cache at
    # all (downloads), which is `OFF` downstream and excluded from the hit ratio; the identity
    # map is what keeps the variable from rendering as `-`.
    map $upstream_cache_status $cache_status {
        ""       "OFF";
        default  $upstream_cache_status;
    }

    # The per-link speed limit, in bytes per second, read out of the token the request carried.
    # The API signs it in as a `limit` field (App\Services\Cdn\SelfHostedProvider::sign); the
    # validator ignores fields it does not know but signs everything before `~hmac=`, so a value
    # read here passed the HMAC — a viewer who edits it gets a 403, not a faster link. No field
    # is 0, which `limit_rate` reads as unlimited. Keyed on $link_token rather than the argument
    # because `strip_token` removes the argument once it validates (see `set $link_token`).
    map $link_token $link_limit {
        "~(^|~)limit=(?<l>[0-9]+)(~|$)"  $l;
        default                          0;
    }

    # The page asking, as the browser names it. A script's fetch (hls.js, dash.js, Shaka) carries
    # Origin; a <video src>, an <img> or a link carries only the Referer.
    map $http_origin $page_url {
        ""       $http_referer;
        default  $http_origin;
    }

    # A request naming no page. A foreign page can hide its Referer (`<meta name="referrer"
    # content="no-referrer">`), but it cannot touch Sec-Fetch-Site, which the browser sets itself.
    # Refusing every anonymous request instead would also cut off native apps and links opened
    # directly, neither of which is another website using the link.
    map $http_sec_fetch_site $anonymous_refused {
        "cross-site"  1;
        default       0;
    }

    # The same request once CDN Settings allows a null origin, which is for an app that is a page on
    # file:// (a webOS or Tizen app, a WebView); the entrypoint writes the line that names this
    # map. Such a page's <img> carries no Origin and no Referer, and Chromium adds `Sec-Fetch-Site:
    # cross-site`: exactly what $anonymous_refused refuses, because a foreign page hiding its
    # Referer sends the same. So the assets are let through, and only them. They are the thumbnails
    # and storyboards, already unsigned; playback keeps the rule above.
    map $uri $anonymous_asset_refused {
        "~^/[0-9A-Za-z]{26}/assets/"  0;
        default                       $anonymous_refused;
    }

    # Whether the page asking is on a site this edge may not serve. The lines are the operator's
    # list from CDN Settings, written by the entrypoint at boot; see there for what passes and why.
    # Read before the cache and the token, and never part of the cache key, so one cached copy of a
    # segment still serves every allowed site.
    map "$page_url|$host" $origin_refused {
        include /usr/local/nginx/conf/allowed-origins.conf;
    }

    # How long a browser or a CDN in front may keep an asset. Only a real answer: a 404 for a thumbnail
    # still being generated, a 429 or a 502 kept for a week would be a broken image for that long,
    # long after the cause is gone.
    map $status $asset_cache_control {
        "~^(200|206|304)$"  "public, max-age=604800";
        default             "no-store";
    }

    # How fast one address can make this edge fetch unsigned assets from S3. Assets need no token, so
    # a made-up ULID in the path was an S3 request anyone could send for free. Applied on the hop to
    # S3, where only a cache miss arrives: at the front door it would also count the thumbnails of a
    # listing page already cached, and a whole office behind one address loads a lot of those. The
    # key is a header the assets location sets and the others clear, so nothing else is counted and
    # a viewer cannot name a key of their own. The burst is a first visit to a page of cold images.
    limit_req_zone $http_x_edge_asset_client zone=asset_misses:10m rate=5r/s;

    # The same idea for master manifests, which cost more per miss than an asset: a request to
    # the API, and through it one to the bucket. Only misses are counted — a manifest somebody
    # already asked for with the same options comes out of the cache — so this is the rate at
    # which one address can make the API work, not the rate at which it can start playbacks.
    # Looser than the assets' because the address may be a carrier's NAT with a city behind it —
    # and going over it refuses nobody: the manifest then comes from the bucket (see the `:8081`
    # server), so the limit protects the API without costing a viewer their playback.
    #
    # The second zone bounds how many of those one address may have in flight. A rate alone does
    # not: a hundred slow requests opened together sit inside any burst, and each one holds a PHP
    # worker for as long as the API takes.
    limit_req_zone $http_x_edge_asset_client zone=manifest_misses:10m rate=20r/s;
    limit_conn_zone $http_x_edge_asset_client zone=manifest_inflight:10m;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';
    # `cache` and `origin` are what decides whether a node needs more disk or the fleet needs
    # another node: bytes served against bytes fetched from S3 for them. Vector ignores keys it
    # was not told about, so an older pipeline reads these lines as before.
    # `token` is the link's token as the request carried it — the value the API minted, which is
    # what every request the link produces has in common and what the mint recorded a tracking id
    # against. Vector hashes it before it leaves the node; nothing downstream sees the token
    # itself. Quoted because it is empty on the unsigned assets, and an empty unquoted value makes
    # the key-value parser swallow the next pair as its value.
    # A response that delivered content: the whole object or a range of it. Everything else — a
    # refusal, an error, a preflight's 204, a 304 with no body — is not usage (see `access_log`).
    map $status $billable {
        200      1;
        206      1;
        default  0;
    }

    log_format  bandwidth  'ip=$remote_addr bytes=$body_bytes_sent video=$video_ulid zone=$video_zone cache=$cache_status origin=$upstream_bytes_received node=${NODE_ID} token="$link_token"';

    access_log off;
    error_log  stderr warn;

    tcp_nodelay     on;
    keepalive_timeout  65;
    # Traefik holds a pool of connections to this server and reuses them for every viewer; the
    # default 1000 requests recycled each of them every few seconds under load.
    keepalive_requests 10000;
    # A client that stopped reading gives its socket buffers back at once, not after a FIN_WAIT.
    reset_timedout_connection on;
    # A player asks for one range. Many in a single request cost the edge far more than they cost
    # the client, and past this limit nginx answers as if no range had been asked for.
    max_ranges 1;

    # Sizes are computed by the entrypoint from the filesystem the cache sits on; see there for
    # what each one guards. The loader and manager are sped up from their defaults because the
    # defaults were set for caches a thousand times smaller: at 100 files per pass the loader
    # takes hours to index a full 10 TB pool (during which max_size is not enforced), and the
    # manager's 400 deletes per second is about the rate a 10 Gbps edge writes new segments at.
    proxy_cache_path /var/cache/nginx/vod
        levels=1:2
        keys_zone=vod_cache:${VOD_CACHE_KEYS_ZONE}
        max_size=${VOD_CACHE_MAX_SIZE}
        min_free=${VOD_CACHE_MIN_FREE}
        inactive=${VOD_CACHE_INACTIVE}
        loader_files=2000 loader_sleep=10ms loader_threshold=100ms
        manager_files=2000 manager_sleep=20ms manager_threshold=200ms
        use_temp_path=off;

    aws_auth $aws_token {
        access_key ${AWS_ACCESS_KEY_ID};
        secret_key ${AWS_SECRET_ACCESS_KEY};
        service s3;
        region ${AWS_DEFAULT_REGION};
    }

    server {
        listen 80 reuseport;

        include /usr/local/nginx/conf/cloudflare-realip.conf;

        # The token the request arrived with, frozen before the access phase: `strip_token` below
        # rewrites both $args and $request_uri once the token validates, so a lazily evaluated
        # variable (a `map`, `$arg_…` read at log time) sees nothing exactly when the request was
        # legitimate. `set` runs in the rewrite phase, ahead of that. Empty here so the log line
        # can name it on the locations that never validate anything (assets, healthz).
        set $link_token "";

        #access_log /dev/stdout main;
        # Buffered, because a write per request is a syscall per segment, and one that stalls the
        # worker whenever the log driver falls behind. 4k and no more: stdout is a pipe shared by
        # every worker, and only a write up to PIPE_BUF is atomic, so a larger buffer could
        # interleave lines from two workers and cost Vector both. A crash loses a second of lines.
        #
        # Only what was actually delivered ($billable). The line books its bytes to the video named
        # in the PATH, and the path is the one thing a request needs no token to choose: a refused
        # request (403), a missing object (404), a limit hit (429) each have a body of a hundred-odd
        # bytes, which used to be booked as streaming on whichever video the URL named — anyone
        # could add requests, bytes and their own address to another tenant's figures, or grow the
        # usage table one made-up ULID at a time.
        access_log /dev/stdout bandwidth buffer=4k flush=1s if=$billable;

        # Delivery only reads. The hop below signs whatever it forwards with the bucket's
        # credentials, method included, so any other method would reach S3 as an authorised request.
        # At server level so that no location, present or future, can leave it out.
        if ($request_method !~ ^(GET|HEAD|OPTIONS)$) {
            return 405;
        }

        # At server level so no location can forget it, preflights included: a refused page gets a
        # 403 with no CORS headers, which its player reports as a network error. The liveness probe
        # carries no Origin and passes.
        if ($origin_refused) {
            return 403;
        }

        # The liveness probe (`nodes:probe` on the API host). Unsigned like the assets, and
        # answered with a header only this nginx sets: a 200 from Traefik, Cloudflare or a
        # stray default vhost is not the edge being up, and the probe requires the header.
        location = /healthz {
            access_log off;
            add_header Cache-Control "no-store" always;
            add_header X-NukeVideo-Edge "${NODE_ID}" always;
            return 204;
        }

        # Thumbnails and storyboards are served unsigned so a listing page can point <img> straight
        # here and both the browser and this cache can keep them: a signed URL changes on every
        # render, which defeats the browser cache entirely. What they give up is the ACL, so the
        # only thing gating them is the 26-character ULID — acceptable for the images, never for
        # anything else.
        #
        # This works because `akamai_token_validate` is declared inside `location /` below rather
        # than at server level: a sibling location does not inherit it. Moving it back up here
        # silently re-locks these, and moving it down further silently unlocks everything.
        location ~ "^/[0-9A-Za-z]{26}/assets/" {
            # `return` runs in the rewrite phase, before token validation: a bodyless 204 without a
            # token is the point, a preflight never carries one. nginx inherits add_header from
            # the enclosing level only when a block declares none, so the block is spelled out.
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin "*";
                add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
                add_header Access-Control-Allow-Headers "Range, Origin, Accept, Content-Type";
                add_header Access-Control-Max-Age 86400;
                add_header Content-Length 0;
                add_header Content-Type text/plain;
                return 204;
            }

            proxy_cache vod_cache;
            proxy_cache_key "$uri";
            proxy_cache_valid 200 30d;
            proxy_cache_valid 404 1m;
            proxy_cache_lock on;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            proxy_set_header X-Edge-Asset-Client $remote_addr;
            proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
            add_header Cache-Control $asset_cache_control always;
            add_header X-Cache-Status $upstream_cache_status always;
            # CORS is answered here, not by the bucket: the upstream's Access-Control-* headers are
            # dropped so one cached copy serves every embedding origin, and `*` is safe because
            # no credentials are involved and a refused origin never gets here ($origin_refused).
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Expose-Headers;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges" always;

            proxy_pass http://edge_origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        # Downloads never touch the cache. They are whole masters, fetched once, and nginx drops
        # the client's Range when proxy_cache is on — so a cached download location turned every
        # resume into a full re-fetch of a multi-GB file, stored as one cache object. Without
        # buffering to disk (proxy_max_temp_file_size 0) the upstream read is paced by the client
        # and nothing is spooled onto the OS disk.
        location ~ "^/[0-9A-Za-z]{26}/download/" {
            # `return` runs in the rewrite phase, before token validation: a bodyless 204 without a
            # token is the point, a preflight never carries one. nginx inherits add_header from
            # the enclosing level only when a block declares none, so the block is spelled out.
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin "*";
                add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
                add_header Access-Control-Allow-Headers "Range, Origin, Accept, Content-Type";
                add_header Access-Control-Max-Age 86400;
                add_header Content-Length 0;
                add_header Content-Type text/plain;
                return 204;
            }

            set $link_token $arg_${VOD_TOKEN_NAME};
            akamai_token_validate $arg_${VOD_TOKEN_NAME};
            akamai_token_validate_key ${VOD_TOKEN_SECRET};
            akamai_token_validate_strip_token ${VOD_TOKEN_NAME};

            proxy_buffering on;
            proxy_buffers 16 64k;
            proxy_max_temp_file_size 0;

            # Per request, so a download manager opening four ranged connections gets four times
            # it; the upstream read is paced by the client either way (no temp file, above).
            limit_rate $link_limit;

            proxy_set_header X-Edge-Asset-Client "";

            add_header X-Cache-Status "OFF" always;
            # A download is meant to land on disk, not in a player tab. The panel lives on another
            # origin, and browsers ignore the anchor's `download` attribute cross-origin, so only
            # this header makes them save the file. No filename: the browser falls back to the last
            # path segment, which is the stored name (ULID plus extension) — unique and safe.
            add_header Content-Disposition "attachment" always;
            # CORS is answered here, not by the bucket: the upstream's Access-Control-* headers are
            # dropped so one cached copy serves every embedding origin, and `*` is safe because
            # no credentials are involved and a refused origin never gets here ($origin_refused).
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Expose-Headers;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges, Content-Disposition" always;

            proxy_pass http://edge_origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        location / {
            # `return` runs in the rewrite phase, before token validation: a bodyless 204 without a
            # token is the point, a preflight never carries one. nginx inherits add_header from
            # the enclosing level only when a block declares none, so the block is spelled out.
            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin "*";
                add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
                add_header Access-Control-Allow-Headers "Range, Origin, Accept, Content-Type";
                add_header Access-Control-Max-Age 86400;
                add_header Content-Length 0;
                add_header Content-Type text/plain;
                return 204;
            }

            set $link_token $arg_${VOD_TOKEN_NAME};
            akamai_token_validate $arg_${VOD_TOKEN_NAME};
            akamai_token_validate_key ${VOD_TOKEN_SECRET};
            akamai_token_validate_strip_token ${VOD_TOKEN_NAME};

            # The manifest's segment URLs are rewritten to carry the SAME token the manifest was
            # requested with, not one this edge generates. The token is what ties every request of
            # a playback session back to the link the API minted — and to the tracking id it was
            # minted for — so a per-manifest token from a `secure_token_akamai` block would leave
            # the segments, which are almost all the bytes, unattributable. The minted token already
            # authorizes them: its ACL is the manifest's directory, and when the panel binds links
            # to the viewer's IP the validator holds every segment to that `ip` field as well. The
            # cost is that segments expire with the link rather than on a window of their own.
            # `secure_token` takes any string with variables; it only appends what it is given.
            secure_token "${VOD_TOKEN_NAME}=$link_token";
            secure_token_types application/dash+xml application/vnd.apple.mpegurl application/x-mpegurl;
            secure_token_avoid_cookies on;
            # Browser caching only — Cache-Control/Expires — and not how long a link is valid, which
            # is the token's `exp`. Segments never change, so a player may keep them for good. A
            # rewritten manifest carries the token in its URL, so a copy kept past the token's
            # expiry is never reused by a newer link, which has a URL of its own.
            secure_token_expires_time 100d;
            secure_token_query_token_expires_time 1h;

            # Applies to the segments because they carry the manifest's token (above), so a capped
            # link caps the whole session. It paces what this edge sends, cache hit or miss alike.
            limit_rate $link_limit;

            # Keyed on the path alone. With the Origin in the key every embedding site got its own
            # copy of every segment, and Vary is ignored for the same reason: the response no
            # longer differs by origin once the CORS headers below replace the bucket's.
            #
            # Manifests are cached too, for 30 seconds (the X-Accel-Expires the signing server
            # sets on them): the cache keeps the bucket's bytes and `secure_token` rewrites them on
            # the way out, so every viewer still gets their own token. They used to bypass the cache
            # entirely, which put an S3 round trip in front of every playback start.
            #
            # The lock holds the viewers of a segment that is still on its way in from S3 instead
            # of sending each of them there too. Five seconds, the default, is short for a 10 s
            # AV1 segment of a top rung — tens of MB — on a slow origin, and past it every waiter
            # fetches on its own and caches nothing. `revalidate` turns the refetch of a segment
            # whose 30 days ran out into a 304.
            proxy_cache vod_cache;
            # A master manifest adds the key of the options it was built with ($manifest_variant);
            # everything else is keyed on the path alone, as before.
            proxy_cache_key "$uri$manifest_variant";
            # A miss is written to the pool as it arrives; 4 KB buffers made that thousands of
            # small writes for one segment.
            proxy_buffer_size 64k;
            proxy_buffers 16 64k;
            # The http_5xx are what cover an S3 outage. S3 is reached through the loopback hop, which
            # answers a failure with a status, so `error` and `timeout` alone never see one.
            #
            # No `proxy_cache_background_update`, tempting as it is for a manifest that expires every
            # 30 seconds. nginx holds the next request on the same connection until the update ends
            # (trac #1723, wontfix), and every connection here is one Traefik reuses for all its
            # viewers: an unrelated viewer's segment would wait on S3, for up to a proxy timeout
            # when S3 hangs. Without it one viewer waits for the refresh and `updating` serves the rest.
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            proxy_set_header X-Edge-Asset-Client $manifest_client;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 30s;
            proxy_cache_lock_age 30s;
            proxy_cache_revalidate on;
            proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
            proxy_cache_valid 200 30d;
            proxy_cache_valid 404 1m;

            add_header X-Cache-Status $upstream_cache_status always;
            # CORS is answered here, not by the bucket: the upstream's Access-Control-* headers are
            # dropped so one cached copy serves every embedding origin, and `*` is safe because
            # no credentials are involved and a refused origin never gets here ($origin_refused).
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Methods;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Expose-Headers;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges" always;

            # The link's token, for the API to read the options key out of. It was stripped from
            # the query above, so this header is the only way it travels on. Sent on every request
            # because `proxy_set_header` cannot be conditional; the bucket hop drops it.
            proxy_set_header X-Link-Token $link_token;

            proxy_pass http://$edge_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }
    }

    # How long the edge may keep a manifest, as the signing server tells it (see `location /`).
    # Empty for everything else, which `add_header` then leaves out, so segments keep their 30 days.
    map $uri $manifest_ttl {
        "~\.(mpd|m3u8)$"  30;
        default           "";
    }

    server {
        listen 127.0.0.1:8080;

        access_log off;
        keepalive_requests 100000;
        # Compression is the outer server's job, after `secure_token`. Inherited from `http`,
        # this hop gzipped a manifest for whichever viewer's Accept-Encoding the miss forwarded,
        # and the outer cached those compressed bytes — which `secure_token` cannot rewrite — for
        # every viewer after it: segment URLs with no token, and every segment a 403.
        gzip off;

        location / {
            rewrite "^.*$" "/${AWS_BUCKET}$uri?" break;

            # Streamed straight through, never buffered here. With buffering on, a download read
            # slowly by its viewer was spooled by THIS hop into a temp file in the container's
            # own filesystem — the OS disk — up to a GB per download, which the `download`
            # location's `proxy_max_temp_file_size 0` was there to prevent and could not reach.
            # The cache fill does not need it either: that side writes to the pool as it reads.
            proxy_buffering off;
            proxy_buffer_size 64k;
            # Unused while buffering is off, but nginx validates them against the buffer size.
            proxy_buffers 4 64k;

            # `notice` sits below the `warn` this nginx logs at: an address being limited is the
            # limit working, and it should not be able to fill the log it is shipped through.
            limit_req zone=asset_misses burst=200 nodelay;
            limit_req_status 429;
            limit_req_log_level notice;

            add_header X-Accel-Expires $manifest_ttl;

            proxy_pass ${AWS_ENDPOINT_SCHEME}://s3_origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_ssl_server_name on;
            proxy_ssl_name ${AWS_ENDPOINT_HOST};
            # Without this anyone on the path could stand in for the bucket and have this edge cache
            # and serve what they chose. The depth is for the intermediates of a public chain.
            proxy_ssl_verify ${VOD_S3_TLS_VERIFY};
            proxy_ssl_verify_depth 4;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_set_header Host ${AWS_ENDPOINT_HOST};
            # The bucket must not see the viewer's origin: its CORS answer is dropped anyway, and
            # a bucket that varies its response on it would defeat the single cached copy.
            proxy_set_header Origin "";
            proxy_set_header X-Edge-Asset-Client "";
            # The viewer's token is for the manifest API, and none of the bucket's business.
            proxy_set_header X-Link-Token "";
            proxy_set_header X-Amz-Date $aws_auth_date;
            proxy_set_header X-Amz-Content-SHA256 UNSIGNED-PAYLOAD;
            proxy_set_header Authorization $aws_token;
        }
    }

    # The hop to the manifest API (see `manifest_origin`): ask the API for the manifest, and hand
    # over the bucket's own copy whenever it does not answer with one.
    #
    # That fallback is the point of this server. The API is a web application behind a network;
    # the bucket's manifest is always there and always plays. So anything but a manifest from the
    # API — an error, a timeout, a redirect, a refusal — ends in the packaged manifest instead of
    # a failed playback start. That is right while what the API adds is a preference (a cap, a
    # subtitle format). A restriction would have to fail closed, and this is the place to change.
    #
    # Either answer is cached by the outer server, under the link's options key: the API's for 30
    # seconds, the bucket's for 10. So a slow or absent API costs one viewer per manifest its
    # timeout, not every viewer, and a manifest already cached keeps being served stale if the
    # API and the bucket both fail.
    server {
        listen 127.0.0.1:8081;

        access_log off;
        keepalive_requests 100000;
        # As on the signing server: the outer rewrites the body, and cannot rewrite a compressed one.
        gzip off;

        # The same pattern as the map that routes here, captured: nothing reaches the request
        # line below that is not a ULID and a plain file name.
        location ~ "^/([0-9A-Za-z]{26})/play/([0-9A-Za-z]+(?:\.[0-9]+)?\.(?:mpd|m3u8))$" {
            # Over either limit is a 429 that `error_page` below turns into the bucket's copy.
            limit_req zone=manifest_misses burst=400 nodelay;
            limit_req_status 429;
            limit_req_log_level notice;
            limit_conn manifest_inflight 10;
            limit_conn_status 429;
            limit_conn_log_level notice;

            # Short, because a viewer is waiting on a file of a few kilobytes and there is a
            # fallback: past these the bucket answers instead.
            proxy_connect_timeout 2s;
            proxy_send_timeout 5s;
            proxy_read_timeout 5s;
            # A manifest is tens of kilobytes at most; the default 4k buffers spooled it to disk.
            proxy_buffer_size 64k;
            proxy_buffers 16 64k;

            # Anything but a manifest goes to the bucket. The errors nginx raises itself come
            # through here too: a refused or timed-out connection (502, 504), the API's
            # connection ceiling reached (502), a limit above exceeded (429).
            proxy_intercept_errors on;
            error_page 301 302 303 307 308 400 401 403 404 405 408 419 429 500 502 503 504 = @bucket;

            # No query: the token was stripped by the validator and travels as a header, and with
            # variables in it nginx sends this URI exactly as written.
            proxy_pass ${MANIFEST_API_SCHEME}://manifest_api${MANIFEST_API_PATH}/manifests/$1/$2;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_ssl_server_name on;
            proxy_ssl_name ${MANIFEST_API_NAME};
            # Always verified: the secret below goes out on this connection. Vector already
            # holds the same URL to the same standard.
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 4;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_set_header Host ${MANIFEST_API_HOST};
            proxy_set_header Authorization "Bearer ${INTERNAL_API_SECRET}";
            proxy_set_header X-Link-Token $http_x_link_token;
            # Uncompressed, for `secure_token` on the outer server.
            proxy_set_header Accept-Encoding "";
            # Nothing else of the viewer's request is the API's business: it trusts its proxies,
            # and these would have been taken as the address and host it was reached on.
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Origin "";
            proxy_set_header Referer "";
            proxy_set_header Cookie "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header X-Edge-Asset-Client "";

            # The API answers like the web application it is: frame, sniffing and referrer
            # policies, HSTS for its own host, a Vary for its own CORS, its rate-limit counters.
            # None of it describes a manifest served from this host, and HSTS in particular would
            # pin the CDN's whole domain to https on the API's say-so. Caching and CORS are the
            # outer server's.
            proxy_hide_header Vary;
            proxy_hide_header Cache-Control;
            proxy_hide_header Set-Cookie;
            proxy_hide_header Strict-Transport-Security;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header X-Content-Type-Options;
            proxy_hide_header Referrer-Policy;
            proxy_hide_header X-Powered-By;
            proxy_hide_header X-RateLimit-Limit;
            proxy_hide_header X-RateLimit-Remaining;

            # How long the outer server may keep it — what the signing server says of a manifest.
            add_header X-Accel-Expires 30;
            # Which of the two answered, for whoever is working out why a link ignores its options.
            add_header X-Manifest-Source api;
        }

        # The packaged manifest, through the signing server: the request as it arrived, same path.
        location @bucket {
            proxy_pass http://edge_origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffer_size 64k;
            proxy_buffers 16 64k;
            # Already counted on the way in; the signing server would count it a second time.
            proxy_set_header X-Edge-Asset-Client "";

            # Kept for less time than the API's answer: this is the copy without the link's
            # options, so it should give way to the real one soon after the API is back, while
            # still sparing the viewers of an outage its timeout. (The signing server's own
            # X-Accel-Expires stops at this hop. On an error the header is not sent, and the
            # outer server applies its own rules.)
            add_header X-Accel-Expires 10;
            add_header X-Manifest-Source bucket;
        }

        location / {
            return 404;
        }
    }
}
