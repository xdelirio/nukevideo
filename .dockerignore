# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml

# IDE
.idea
.vscode
.fleet
.nova
.zed
.phpactor.json

.claude
.superpowers

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*

# Dependencies (installed in container)
/vendor
/node_modules

# SPA: the api and proxy images never serve it, and shipping it in the context invalidates
# api-build's `COPY . .` layer on every front-only commit. front-dev bind-mounts it at runtime.
/front

# Storage & cache. storage/app keeps its two directories and nothing in them: a developer's local
# files there (scratch exports, benchmark dumps) must not ride into a published image.
/storage/app/*
!/storage/app/private
!/storage/app/public
/storage/app/private/*
/storage/app/public/*
/storage/logs
/storage/framework/cache
/storage/framework/sessions
/storage/framework/views
/storage/framework/testing
/storage/pail
/.phpunit.cache
.phpunit.result.cache
bootstrap/cache/*

# Build artifacts
/public/build
/public/hot
/public/storage
/storage/*.key

# Docker and repository tooling the image never runs
compose.yml
compose.prod.yml
Dockerfile
.dockerignore
.editorconfig
/bin

# Documentation (the docs site is its own project; the API never reads it). vector/ and vod/ stay:
# NodeService ships vector/vector.yaml and CloudflareDns reads vod/nginx at runtime.
/docs
*.md
LICENSE

# Tests
/tests
phpunit.xml

# Misc
Homestead.json
Homestead.yaml
*.log
/auth.json
